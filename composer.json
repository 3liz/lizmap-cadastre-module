{
    "name": "lizmap/lizmap-cadastre-module",
    "type": "jelix-module",
    "description": "Jelix module for Lizmap, which adds tools to interact with french cadastral data",
    "keywords": ["module", "jelix", "lizmap", "cadastre"],
    "homepage": "http://3liz.com",
    "license": "MPL-2.0",
    "authors": [
        {
            "name": "Michaël Douchin",
            "email": "mdouchin@3liz.com"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "minimum-stability": "stable",
    "extra" : {
        "jelix" : {
            "modules": [
                "cadastre/"
            ],
            "autoconfig-access-16" : {
                "lizmap@3liz.com" : {
                    "cadastre": {
                        "__global": 1,
                        "index" : 2
                    }
                }
            }
        }
    }
}
